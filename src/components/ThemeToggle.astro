<button
  type="button"
  class="theme-toggle"
  aria-label="ダークモードに切り替える"
  aria-pressed="false"
>
  <svg class="moon" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M13.9898 8.32394C13.9273 9.48137 13.5309 10.5959 12.8485 11.5329C12.1661 12.4698 11.2269 13.1891 10.1445 13.6036C9.06205 14.0182 7.8827 14.1104 6.749 13.869C5.61529 13.6276 4.57578 13.063 3.75612 12.2434C2.93646 11.4238 2.37174 10.3844 2.13022 9.25068C1.88871 8.117 1.98074 6.93764 2.3952 5.85515C2.80965 4.77266 3.52878 3.8334 4.46566 3.1509C5.40254 2.4684 6.51706 2.07188 7.67448 2.00927C7.94448 1.99461 8.08581 2.31594 7.94248 2.54461C7.46307 3.31164 7.25779 4.21852 7.36014 5.11724C7.46249 6.01596 7.86643 6.85346 8.50603 7.49306C9.14563 8.13266 9.98313 8.53659 10.8818 8.63894C11.7806 8.74129 12.6874 8.53601 13.4545 8.05661C13.6838 7.91327 14.0045 8.05394 13.9898 8.32394Z"></path>
  </svg>
  <svg class="sun" viewBox="0 0 16 16" aria-hidden="true">
    <circle cx="8" cy="8" r="2.667"></circle>
    <path d="M8 2v.667M8 13.333V14M2 8h.667M13.333 8H14M12.243 3.757l-.472.472M4.229 11.771l-.472.472M3.757 3.757l.472.472M11.771 11.771l.472.472"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");

  const sync = () => {
    const dark = root.dataset.theme === "dark";
    button?.setAttribute("aria-pressed", String(dark));
    button?.setAttribute(
      "aria-label",
      dark ? "ライトモードに切り替える" : "ダークモードに切り替える",
    );
  };

  sync();
  button?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      // 保存できない環境では、このページを開いている間だけ切り替える
    }
    sync();
  });
</script>

<style>
  button {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  svg {
    position: absolute;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.333;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  :global([data-theme="dark"]) .moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  :global([data-theme="dark"]) .sun {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    svg {
      transition: none;
    }
  }
</style>

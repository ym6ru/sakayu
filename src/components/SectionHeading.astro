---
import BriefcaseBusiness from "../icons/briefcase-business.svg";
import Mail from "../icons/mail.svg";
import PenTool from "../icons/pen-tool.svg";

const icons = { mail: Mail, "briefcase-business": BriefcaseBusiness, "pen-tool": PenTool };

interface Props {
  icon: keyof typeof icons;
  id?: string;
  level?: 1 | 2;
}

const { icon, id, level = 2 } = Astro.props;
const Tag = `h${level}` as const;
const Icon = icons[icon];
---

<Tag id={id} lang="en">
  <Icon width={16} height={16} aria-hidden="true" />
  <slot />
</Tag>

<style>
  h1,
  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
</style>

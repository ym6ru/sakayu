---
interface Props {
  size: number;
  color?: string;
  reveal?: boolean;
}

const { size, color = "0 0 255", reveal = false } = Astro.props;
---

<span class:list={["scale", { reveal }]} style={`--size: ${size}px; --c: ${color}`}>
  <slot />
</span>

<style>
  @property --sweep {
    syntax: "<angle>";
    inherits: false;
    initial-value: 360deg;
  }

  .scale {
    display: grid;
    place-items: center;
    inline-size: var(--size);
    block-size: var(--size);
    box-sizing: border-box;
    border: calc(var(--size) * 3 / 105) solid transparent;
    border-radius: 50%;
    background:
      linear-gradient(#fff, #fff) padding-box,
      conic-gradient(from 180deg, rgb(var(--c)), rgb(var(--c) / 0) var(--sweep)) border-box;
    box-shadow: 0 0 calc(var(--size) / 7) rgb(0 0 255 / 10%);
  }

  .reveal {
    --sweep: 0deg;
    box-shadow: 0 0 0 rgb(0 0 255 / 0%);
    transition:
      --sweep 0.6s ease-out,
      box-shadow 0.6s ease-out;
  }

  :global(:is(a:hover, a:focus-visible)) .reveal {
    --sweep: 360deg;
    box-shadow: 0 0 calc(var(--size) / 7) rgb(0 0 255 / 10%);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      transition: none;
    }
  }
</style>

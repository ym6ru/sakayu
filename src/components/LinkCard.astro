---
import { Image, inferRemoteSize } from "astro:assets";
import { getOgp } from "../lib/ogp";

interface Props {
  url: string;
}

const { url } = Astro.props;
const { title, description, image } = await getOgp(url);
const host = new URL(url).host;

const imageWidth = 480;
const imageSize = image
  ? await inferRemoteSize(image)
      .then(({ width, height }) => ({
        width: imageWidth,
        height: Math.round((imageWidth * height) / width),
      }))
      .catch(() => undefined)
  : undefined;
---

<a class="card" href={url} target="_blank" rel="noopener noreferrer">
  <span class="text">
    <span class="title">{title ?? url}</span>
    {description && <span class="description">{description}</span>}
    <span class="host">{host}</span>
  </span>
  {image && imageSize && <Image src={image} alt="" {...imageSize} format="avif" />}
</a>

<style>
  .card {
    display: flex;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 8px;

    @media (width < 40rem) {
      flex-direction: column-reverse;
    }

    &:hover {
      text-decoration-line: none;
      background-color: var(--color-hover);
    }
  }

  .text {
    display: grid;
    flex: 1;
    align-content: center;
    gap: var(--space-1);
    min-inline-size: 0;
    padding: var(--space-3) var(--space-4);
    line-height: 1.5;
  }

  .title {
    overflow: hidden;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .description,
  .host {
    overflow: hidden;
    color: var(--color-text-sub);
    font-size: var(--text-xs);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  img {
    flex-shrink: 0;
    align-self: center;
    inline-size: 15rem;
    block-size: auto;
    border-inline-start: 1px solid var(--color-border);

    @media (width < 40rem) {
      inline-size: 100%;
      border-inline-start: 0;
      border-block-end: 1px solid var(--color-border);
    }
  }
</style>

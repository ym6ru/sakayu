---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts } from "../lib/posts";
import horo from "../assets/works/horo.jpg";
import BriefcaseBusiness from "../icons/briefcase-business.svg";
import Mail from "../icons/mail.svg";
import PenTool from "../icons/pen-tool.svg";

const contacts = [
  { label: "X", id: "@XpKM4agvDSOfoGp", href: "https://x.com/XpKM4agvDSOfoGp" },
  { label: "GitHub", id: "ym6ru", href: "https://github.com/ym6ru" },
];

const works: { name: string; description: string; href?: string; image?: ImageMetadata }[] = [
  { name: "3D 紙箱シミュレータ", description: "開発中" },
  { name: "放浪 / Horo", description: "妻のブログ", href: "https://horohororo.com/", image: horo },
];

const posts = (await getPublishedPosts()).slice(0, 4);
---

<Base title="sakayu.dev">
  <main>
    <div class="profile">
      <img src="/favicon.svg" alt="" width="36" height="36" />
      <h1 lang="en">Yuki Matsusaka</h1>
    </div>
    <div class="intro">
      <p>作ったもの、考えたことを記録しています。</p>
      <p>
        ユーザーインターフェースデザインやWebフロントエンドの技術に興味があります。おさかなと植物が好きです。
      </p>
    </div>
    <section aria-labelledby="contact">
      <h2 id="contact" lang="en">
        <Mail width={16} height={16} aria-hidden="true" />
        Contact
      </h2>
      <ul>
        {contacts.map(({ label, id, href }) => (
          <li>
            {label}：
            <a href={href} target="_blank" rel="me noopener noreferrer">
              {id}
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="works">
      <h2 id="works" lang="en">
        <BriefcaseBusiness width={16} height={16} aria-hidden="true" />
        Works
      </h2>
      <ul class="works">
        {works.map(({ name, description, href, image }) => {
          const Tag = href ? "a" : "div";
          return (
            <li>
              <Tag
                class="work"
                {...(href && { href, target: "_blank", rel: "noopener noreferrer" })}
              >
                {image ? (
                  <Image
                    src={image}
                    alt=""
                    width={256}
                    height={160}
                    densities={[1, 2]}
                    format="avif"
                  />
                ) : (
                  <div class="placeholder" />
                )}
                <span>{name}</span>
                <small>{description}</small>
              </Tag>
            </li>
          );
        })}
      </ul>
    </section>
    <section aria-labelledby="diary">
      <h2 id="diary" lang="en">
        <PenTool width={16} height={16} aria-hidden="true" />
        Diary
      </h2>
      <div class="posts">
        <PostList posts={posts} />
      </div>
      <a class="all" href="/blog">
        すべての日記を見る
      </a>
    </section>
  </main>
</Base>

<style>
  main {
    padding-block-start: var(--space-page);
  }

  .profile {
    display: flex;
    align-items: center;
    gap: var(--space-3);

    & img {
      border-radius: 8px;
    }
  }

  h1 {
    font-size: var(--text-base);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
  }

  .intro {
    margin-block-start: var(--space-5);
    color: var(--color-text-sub);
    font-size: var(--text-base);
    font-weight: var(--weight-light);
    line-height: var(--leading-loose);
    letter-spacing: var(--tracking-body);
  }

  section {
    margin-block-start: var(--space-7);
    font-size: var(--text-lg);
  }

  section + section {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-6);
    background: linear-gradient(var(--color-border), var(--color-border)) no-repeat 0 0 / 20rem 1px;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  ul {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
    font-size: var(--text-base);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-body);
  }

  .works {
    grid-template-columns: repeat(auto-fill, 16rem);
    gap: var(--space-5) var(--space-4);

    & .work {
      display: grid;
      gap: var(--space-3);
      font-weight: var(--weight-regular);
    }

    & img,
    & .placeholder {
      inline-size: 16rem;
      block-size: 10rem;
      border: 1px solid var(--color-line-subtle);
      border-radius: 8px;
    }

    & img {
      object-fit: cover;
    }

    & .placeholder {
      background-color: var(--color-hover);
    }

    & a:hover {
      text-decoration-line: none;
    }

    & span {
      font-size: var(--text-sm);
      text-decoration-color: var(--color-underline);
      text-decoration-thickness: var(--underline-thickness);
      text-underline-offset: var(--underline-offset);
    }

    & a:hover span {
      text-decoration-line: underline;
    }

    & small {
      margin-block-start: calc(-1 * var(--space-2));
      color: var(--color-text-sub);
      font-size: var(--text-xs);
    }
  }

  .posts {
    margin-block-start: var(--space-4);
  }

  .all {
    display: inline-block;
    margin-block-start: var(--space-5);
    font-size: var(--text-base);
    letter-spacing: var(--tracking-body);
  }
</style>

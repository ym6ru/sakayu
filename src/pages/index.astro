---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts } from "../lib/posts";

const contacts = [
  { label: "X", id: "@XpKM4agvDSOfoGp", href: "https://x.com/XpKM4agvDSOfoGp" },
  { label: "GitHub", id: "ym6ru", href: "https://github.com/ym6ru" },
];

const posts = (await getPublishedPosts()).slice(0, 4);
---

<Base title="sakayu.dev">
  <main>
    <div class="profile">
      <img src="/favicon.svg" alt="" width="36" height="36" />
      <h1 lang="en">Yuki Matsusaka</h1>
    </div>
    <div class="intro">
      <p>作ったもの、考えたことを記録しています。</p>
      <p>
        ユーザーインターフェースデザインやWebフロントエンドの技術に興味があります。おさかなと植物が好きです。
      </p>
    </div>
    <section aria-labelledby="contact">
      <h2 id="contact" lang="en">
        Contact
      </h2>
      <ul>
        {contacts.map(({ label, id, href }) => (
          <li>
            {label}：
            <a href={href} target="_blank" rel="me noopener noreferrer">
              {id}
            </a>
          </li>
        ))}
      </ul>
    </section>
    <hr />
    <section aria-labelledby="diary">
      <div class="section-heading">
        <h2 id="diary" lang="en">
          Diary
        </h2>
        <a href="/blog">過去の日記</a>
      </div>
      <div class="posts">
        <PostList posts={posts} />
      </div>
    </section>
  </main>
</Base>

<style>
  main {
    padding-block-start: var(--space-page);
  }

  .profile {
    display: flex;
    align-items: center;
    gap: var(--space-3);

    & img {
      border-radius: 8px;
    }
  }

  h1 {
    font-size: var(--text-base);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-wide);
  }

  .intro {
    margin-block-start: var(--space-5);
    color: var(--color-text-sub);
    font-size: var(--text-base);
    font-weight: var(--weight-light);
    line-height: var(--leading-loose);
    letter-spacing: var(--tracking-body);
  }

  section {
    margin-block-start: var(--space-section);
    font-size: var(--text-lg);
  }

  hr {
    max-inline-size: 22.5rem;
    margin-block: 7.5rem;
  }

  hr + section {
    margin-block-start: 0;
  }

  h2 {
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  ul {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-5);
    padding: 0;
    list-style: none;
    font-size: var(--text-base);
    font-weight: var(--weight-light);
    letter-spacing: var(--tracking-body);
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: var(--space-4);

    & a {
      font-size: var(--text-base);
      font-weight: var(--weight-light);
      letter-spacing: var(--tracking-body);
    }
  }

  .posts {
    margin-block-start: var(--space-5);
  }
</style>

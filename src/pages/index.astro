---
import Base from "../layouts/Base.astro";

const textSizes = [
  ["--text-display", "表示 Display"],
  ["--text-2xl", "ページ見出し"],
  ["--text-xl", "記事タイトル・h2"],
  ["--text-lg", "h3・リード文"],
  ["--text-base", "本文 Body text"],
  ["--text-sm", "補足・キャプション"],
  ["--text-xs", "メタ情報 2026.10.22"],
];

const spaces = [
  "--space-1",
  "--space-2",
  "--space-3",
  "--space-4",
  "--space-5",
  "--space-6",
  "--space-section",
  "--space-page",
];

const colors = ["--color-bg", "--color-text", "--color-text-muted", "--color-link", "--color-line"];
---

<Base title="Design tokens">
  <main>
    <header>
      <p class="muted">Design tokens — draft</p>
      <h1>静かで読みやすい文字組みのための、ちいさな約束ごと。</h1>
    </header>

    <section>
      <h2>Type scale</h2>
      <ul class="scale">
        {textSizes.map(([token, label]) => (
          <li>
            <code>{token}</code>
            <span style={`font-size: var(${token})`}>{label}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Article</h2>
      <article>
        <p class="muted">
          <time datetime="2026-10-22">2026.10.22</time>
        </p>
        <h3>モダンさより、何が本当に大事か</h3>
        <p>
          以前は新しい技術を使うことばかり考えていました。けれど、読む人にとって大切なのは、ページがすぐに開いて、文字が心地よく目に入ってくることです。Gen
          Interface JP は Inter と Noto Sans JP をもとにした書体で、和文と欧文 Typography
          の混植でもリズムが崩れにくいのが特徴です。
        </p>
        <p>
          行間は本文で 2、UI で 1.75。本文の幅は <a href="/blog">42rem</a> に抑え、一行がおよそ
          33〜38 文字に収まるようにしています。
        </p>
      </article>
    </section>

    <section>
      <h2>Spacing</h2>
      <ul class="spaces">
        {spaces.map((token) => (
          <li>
            <code>{token}</code>
            <span class="bar" style={`inline-size: var(${token})`} />
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Color</h2>
      <ul class="colors">
        {colors.map((token) => (
          <li>
            <span class="swatch" style={`background: var(${token})`} />
            <code>{token}</code>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>

<style>
  main {
    max-inline-size: calc(var(--measure) + var(--gutter) * 2);
    margin-inline: auto;
    padding: var(--space-page) var(--gutter);
  }

  header h1 {
    font-size: var(--text-2xl);
    margin-block-start: var(--space-3);
  }

  section {
    margin-block-start: var(--space-section);
  }

  h2 {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
    margin-block-end: var(--space-5);
  }

  ul {
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  code {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .scale li {
    display: grid;
    gap: var(--space-1);
  }

  .scale span {
    line-height: var(--leading-tight);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .muted {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  article {
    line-height: var(--leading-loose);
  }

  article h3 {
    font-size: var(--text-xl);
    margin-block: var(--space-2) var(--space-5);
  }

  article p + p {
    margin-block-start: var(--space-4);
  }

  .spaces li {
    display: grid;
    gap: var(--space-1);
  }

  .bar {
    display: block;
    max-inline-size: 100%;
    block-size: var(--space-2);
    background: var(--color-text);
  }

  .colors {
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
  }

  .swatch {
    display: block;
    aspect-ratio: 1;
    border: 1px solid var(--color-line);
    margin-block-end: var(--space-2);
  }
</style>

---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Profile from "../../components/Profile.astro";
import ChevronLeft from "../../icons/chevron-left.svg";
import { formatDate, getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} | sakayu.dev`}>
  <main>
    <Profile />
    <article>
      <a class="back" href="/blog">
        <ChevronLeft width={16} height={16} aria-hidden="true" />
        <span>ブログ</span>
      </a>
      <header>
        <Image src={post.data.icon} alt="" width={48} height={48} densities={[1, 2, 3]} />
        <h1>{post.data.title}</h1>
        <time datetime={post.data.publishedAt}>{formatDate(post.data.publishedAt)}</time>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Base>

<style>
  main {
    padding-block-start: var(--space-page);
  }

  article {
    position: relative;
    margin-block-start: var(--space-7);
  }

  .back {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    inline-size: fit-content;
    margin-block-end: var(--space-4);
    color: var(--color-text-sub);
    font-size: var(--text-sm);
    white-space: nowrap;

    & svg {
      flex-shrink: 0;
    }

    &:hover {
      text-decoration-line: none;
    }

    & span {
      text-decoration-color: var(--color-underline);
      text-decoration-thickness: var(--underline-thickness);
      text-underline-offset: var(--underline-offset);
    }

    &:hover span {
      text-decoration-line: underline;
    }

    @media (width >= 72rem) {
      position: absolute;
      inset-block-start: 0;
      inset-inline-end: calc(100% + var(--space-6));
      block-size: 4rem;
      margin-block-end: 0;
    }
  }

  header {
    display: grid;
    gap: var(--space-2);
  }

  header img {
    box-sizing: content-box;
    padding: var(--space-2);
    margin-inline-start: calc(-1 * var(--space-2));
  }

  h1 {
    margin-block-start: var(--space-4);
    font-size: var(--text-base);
    font-weight: var(--weight-regular);
    line-height: var(--leading-normal);
  }

  time {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .prose {
    margin-block-start: var(--space-7);
    font-weight: var(--weight-light);
    line-height: var(--leading-loose);
    letter-spacing: var(--tracking-body);

    & :global(:is(p, ul, ol, blockquote, pre, figure, img)) {
      margin-block-start: var(--space-5);
    }

    & :global(h2) {
      margin-block: var(--space-7) var(--space-3);
      font-size: var(--text-md);
    }

    & :global(h3) {
      margin-block: var(--space-6) var(--space-2);
      font-size: var(--text-base);
    }

    & :global(:is(h2, h3) + *) {
      margin-block-start: 0;
    }

    & :global(:is(ul, ol)) {
      padding-inline-start: 1.5em;
    }

    & :global(li + li) {
      margin-block-start: var(--space-2);
    }

    & :global(blockquote) {
      padding-inline-start: var(--space-3);
      border-inline-start: 1px solid var(--color-line);
      color: var(--color-text-muted);
    }

    & :global(code) {
      font-size: 0.875em;
    }

    & :global(pre) {
      padding: var(--space-3);
      overflow-x: auto;
      line-height: var(--leading-normal);
      letter-spacing: 0;
    }

    & :global(hr) {
      margin-block: var(--space-7);
    }
  }
</style>

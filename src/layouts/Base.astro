---
import "gen-interface-jp/300.css";
import "gen-interface-jp/400.css";
import "gen-interface-jp/500.css";
import "../styles/tokens.css";
import "../styles/base.css";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { site } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  publishedAt?: string;
  noindex?: boolean;
}

const { title, description = site.description, publishedAt, noindex = false } = Astro.props;
const url = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ""), Astro.site);
const image = new URL("/og.png", Astro.site);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <meta property="og:type" content={publishedAt ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {
          // 読めない環境では OS の設定に従う
        }
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <script is:inline>
      (() => {
        if (!("fonts" in document)) return;
        const root = document.documentElement;
        root.classList.add("fonts-loading");
        const timeout = new Promise((resolve) => setTimeout(resolve, 2000));
        const loaded = new Promise((resolve) => {
          document.addEventListener("DOMContentLoaded", () => {
            document.body.getBoundingClientRect();
            document.fonts.ready.then(resolve);
          });
        });
        Promise.race([loaded, timeout]).then(() => root.classList.remove("fonts-loading"));
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <div class="theme">
        <ThemeToggle />
      </div>
      <slot />
      <Footer />
    </div>
  </body>
</html>

<style>
  .page {
    position: relative;
  }

  .theme {
    position: absolute;
    inset-block-start: var(--space-page);
    inset-inline-end: 0;
  }
</style>

---
import "gen-interface-jp/400.css";
import "gen-interface-jp/600.css";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
